# Copy to .env and fill in. Never commit .env.

# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# JSON key for a Google Cloud service account with the Sheets API enabled.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
# Share the sheet with the service account's email as Editor.
SHEET_ID=

# Optional: folder holding your resume, projects and so on. Point this at your
# Google Drive for desktop folder so both machines read the same files.
# CORPUS_DIR=G:/My Drive/Career
